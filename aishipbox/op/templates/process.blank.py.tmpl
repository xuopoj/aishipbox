class Process:
    def __init__(self, args):
        # args 含业务参数；args.obs_input_path / args.obs_output_path 由框架注入。
        self.args = args

    def __call__(self, input):
        logger.info("Process input=%s", type(input).__name__)
        # TODO: 实现推理逻辑。建议返回 pandas.DataFrame。
        return input


